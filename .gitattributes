# Godot always writes its own text formats with LF, regardless of platform.
# Pin them to LF here so core.autocrlf (which defaults to true on Windows)
# doesn't fight Godot and leave every .import/project.godot file perpetually
# "modified" with no actual content change.
* text=auto eol=lf

*.gd        text eol=lf
*.gdshader  text eol=lf
*.tscn      text eol=lf
*.tres      text eol=lf
*.import    text eol=lf
*.godot     text eol=lf
*.cfg       text eol=lf
project.godot text eol=lf

# Binary assets — never subject to line-ending conversion.
*.png  binary
*.jpg  binary
*.jpeg binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.ttf  binary
*.otf  binary
*.exe  binary
*.pck  binary
